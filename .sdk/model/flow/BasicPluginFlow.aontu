# BasicPluginFlow

main: kit: flow: BasicPluginFlow:
{
  entity: "plugin",
  kind: "basic",
  name: "BasicPluginFlow",
  step: [
    {
      m: {
        board_id: "board01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "plugin_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "plugin_ref01",
        srcdatavar: "plugin_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-plugin_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "plugin_ref01",
        srcdatavar: "plugin_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "plugin01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-plugin_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPluginFlow"
}