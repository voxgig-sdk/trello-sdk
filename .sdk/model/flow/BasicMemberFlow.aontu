# BasicMemberFlow

main: kit: flow: BasicMemberFlow:
{
  entity: "member",
  kind: "basic",
  name: "BasicMemberFlow",
  step: [
    {
      i: {
        ref: "member_ref01"
      }

      m: {
        action_id: "action01",
        board_id: "board01",
        enterprise_id: "enterprise01",
        organization_id: "organization01",
        token_id: "token01"
      }

      o: "create"
    }

    {
      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "member_ref01"
          }
        }
      ]
    }

    {
      d: {
        organization_id: "organization01"
      }

      i: {
        ref: "member_ref01",
        srcdatavar: "member_ref01_data",
        suffix: "_up0",
        textfield: "aaEmail"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-member_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "member_ref01",
        srcdatavar: "member_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "member01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-member_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "member_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "member01",
        organization_id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        organization_id: "organization01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "member_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMemberFlow"
}