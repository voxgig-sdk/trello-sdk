# BasicPendingOrganizationFlow

main: kit: flow: BasicPendingOrganizationFlow:
{
  entity: "pending_organization",
  kind: "basic",
  name: "BasicPendingOrganizationFlow",
  step: [
    {
      m: {
        enterprise_id: "enterprise01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "pending_organization_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPendingOrganizationFlow"
}