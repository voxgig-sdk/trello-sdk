# BasicBoardFlow

main: kit: flow: BasicBoardFlow:
{
  entity: "board",
  kind: "basic",
  name: "BasicBoardFlow",
  step: [
    {
      input: {
        ref: "board_ref01"
      }

      match: {
        member_id: "member01",
        organization_id: "organization01"
      }

      op: "create"
    }

    {
      match: {
        member_id: "member01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "board_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "board_ref01",
        srcdatavar: "board_ref01_data",
        suffix: "_up0",
        textfield: "creationMethod"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "board_ref01",
        srcdatavar: "board_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "board01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "board_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "board01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        member_id: "member01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "board_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBoardFlow"
}