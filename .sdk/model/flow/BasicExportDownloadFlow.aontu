# BasicExportDownloadFlow

main: kit: flow: BasicExportDownloadFlow:
{
  entity: "export_download",
  kind: "basic",
  name: "BasicExportDownloadFlow",
  step: [
    {
      i: {
        ref: "export_download_ref01",
        srcdatavar: "export_download_ref01_data",
        suffix: "_dt0"
      }

      m: {
        board_id: "board01",
        id: "export_download01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-export_download_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicExportDownloadFlow"
}