      }

      o: "create"
    }

    {
      m: {
        member_id: "member01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "saved_search_ref01"
          }
        }
      ]
    }

    {
      d: {
        member_id: "member01"
      }

      i: {
        ref: "saved_search_ref01",
