        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-saved_search_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "saved_search_ref01",
