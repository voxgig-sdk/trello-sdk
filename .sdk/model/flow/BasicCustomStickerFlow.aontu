# BasicCustomStickerFlow

main: kit: flow: BasicCustomStickerFlow:
{
  entity: "custom_sticker",
  kind: "basic",
  name: "BasicCustomStickerFlow",
  step: [
    {
      i: {
        ref: "custom_sticker_ref01"
      }

      m: {
        member_id: "member01"
      }

      o: "create"
    }

    {
      m: {
        member_id: "member01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "custom_sticker_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "custom_sticker_ref01",
        srcdatavar: "custom_sticker_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "custom_sticker01",
        member_id: "member01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-custom_sticker_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "custom_sticker_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "custom_sticker01",
        member_id: "member01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        member_id: "member01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "custom_sticker_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCustomStickerFlow"
}