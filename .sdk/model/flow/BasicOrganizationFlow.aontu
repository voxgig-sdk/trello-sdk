# BasicOrganizationFlow

main: kit: flow: BasicOrganizationFlow:
{
  entity: "organization",
  kind: "basic",
  name: "BasicOrganizationFlow",
  step: [
    {
      i: {
        ref: "organization_ref01"
      }

      m: {
        action_id: "action01",
        enterprise_id: "enterprise01",
        member_id: "member01"
      }

      o: "create"
    }

    {
      m: {
        member_id: "member01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "organization_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "organization_ref01",
        srcdatavar: "organization_ref01_data",
        suffix: "_up0",
        textfield: "dateLastActivity"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "organization_ref01",
        srcdatavar: "organization_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "organization01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "organization_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "organization01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        member_id: "member01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "organization_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOrganizationFlow"
}