# BasicReactionFlow

main: kit: flow: BasicReactionFlow:
{
  entity: "reaction",
  kind: "basic",
  name: "BasicReactionFlow",
  step: [
    {
      input: {
        ref: "reaction_ref01",
        srcdatavar: "reaction_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "reaction01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-reaction_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReactionFlow"
}