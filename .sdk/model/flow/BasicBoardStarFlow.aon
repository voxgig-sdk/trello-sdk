# BasicBoardStarFlow

main: kit: flow: BasicBoardStarFlow:
{
  entity: "board_star",
  kind: "basic",
  name: "BasicBoardStarFlow",
  step: [
    {
      input: {
        ref: "board_star_ref01"
      }

      match: {
        member_id: "member01"
      }

      op: "create"
    }

    {
      match: {
        board_id: "board01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "board_star_ref01"
          }
        }
      ]
    }

    {
      data: {
        member_id: "member01"
      }

      input: {
        ref: "board_star_ref01",
        srcdatavar: "board_star_ref01_data",
        suffix: "_up0",
        textfield: "idBoard"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_star_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "board_star_ref01",
        srcdatavar: "board_star_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "board_star01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_star_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "board_star_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "board_star01",
        member_id: "member01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        board_id: "board01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "board_star_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBoardStarFlow"
}