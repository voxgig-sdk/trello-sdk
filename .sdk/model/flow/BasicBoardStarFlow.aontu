# BasicBoardStarFlow

main: kit: flow: BasicBoardStarFlow:
{
  entity: "board_star",
  kind: "basic",
  name: "BasicBoardStarFlow",
  step: [
    {
      i: {
        ref: "board_star_ref01"
      }

      m: {
        member_id: "member01"
      }

      o: "create"
    }

    {
      m: {
        board_id: "board01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "board_star_ref01"
          }
        }
      ]
    }

    {
      d: {
        member_id: "member01"
      }

      i: {
        ref: "board_star_ref01",
        srcdatavar: "board_star_ref01_data",
        suffix: "_up0",
        textfield: "idBoard"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_star_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "board_star_ref01",
        srcdatavar: "board_star_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "board_star01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_star_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "board_star_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "board_star01",
        member_id: "member01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        board_id: "board01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "board_star_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBoardStarFlow"
}