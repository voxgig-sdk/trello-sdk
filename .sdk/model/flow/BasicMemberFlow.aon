# BasicMemberFlow

main: kit: flow: BasicMemberFlow:
{
  entity: "member",
  kind: "basic",
  name: "BasicMemberFlow",
  step: [
    {
      input: {
        ref: "member_ref01"
      }

      match: {
        action_id: "action01",
        board_id: "board01",
        enterpris_id: "enterpris01",
        organization_id: "organization01",
        token_id: "token01"
      }

      op: "create"
    }

    {
      match: {
        organization_id: "organization01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "member_ref01"
          }
        }
      ]
    }

    {
      data: {
        organization_id: "organization01"
      }

      input: {
        ref: "member_ref01",
        srcdatavar: "member_ref01_data",
        suffix: "_up0",
        textfield: "aaEmail"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-member_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "member_ref01",
        srcdatavar: "member_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "member01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-member_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "member_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "member01",
        organization_id: "organization01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        organization_id: "organization01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "member_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMemberFlow"
}